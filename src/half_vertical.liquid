{% if moon.ok %}
<div class="layout layout--col gap--small">
  {{ mn_disc }}
  <span class="title title--large lg:title--xlarge">{{ mn_phase }}</span>
  <span class="description lg:description--large">{{ mn_detail_short }}</span>
  <div class="flex flex--row gap--xlarge">
    <div class="flex flex--col gap--none"><span class="label label--small">{{ mn_w_rise_short }}</span><span class="value value--small lg:value--large lg:portrait:value--base value--tnums mn-time">{{ mn_rise }}</span></div>
    <div class="flex flex--col gap--none"><span class="label label--small">{{ mn_w_set_short }}</span><span class="value value--small lg:value--large lg:portrait:value--base value--tnums mn-time">{{ mn_set }}</span></div>
  </div>
  {{ mn_bar }}
  <div class="flex flex--col gap--none"><span class="label label--small">{{ mn_w_full }}</span><span class="value value--xsmall lg:value--small">{{ mn_full_date }}</span></div>
</div>
{% else %}
{{ mn_empty }}
{% endif %}
{{ mn_title_bar }}
