{% if moon.ok %}
<div class="layout layout--row gap--large">
  {{ mn_disc }}
  <div class="flex flex--col flex--left gap--xsmall grow">
    <span class="title title--large lg:title--xlarge">{{ mn_phase }}</span>
    <span class="description lg:description--large">{{ mn_detail }}</span>
    <div class="flex flex--row gap--large">
      <div class="flex flex--col flex--left gap--none"><span class="label label--small">{{ mn_w_rise }}</span><span class="value value--small lg:value--large value--tnums mn-time">{{ mn_rise }}</span></div>
      <div class="flex flex--col flex--left gap--none"><span class="label label--small">{{ mn_w_set }}</span><span class="value value--small lg:value--large value--tnums mn-time">{{ mn_set }}</span></div>
      <div class="flex flex--col flex--left gap--none"><span class="label label--small">{{ mn_w_full }}</span><span class="value value--xsmall lg:value--small">{{ mn_full_date }}</span></div>
    </div>
    {{ mn_bar }}
  </div>
</div>
{% else %}
{{ mn_empty }}
{% endif %}
{{ mn_title_bar }}
