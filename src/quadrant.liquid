{% if moon.ok %}
{% comment %} "4:04 PM 12:17 AM" is wider than the TRMNL X portrait quadrant at value--large: 12-hour times a size down. {% endcomment %}
{% if mn_t == "t12" %}{% assign mn_q_size = "value--base" %}{% else %}{% assign mn_q_size = "value--large" %}{% endif %}
<div class="layout layout--row portrait:layout--col gap--medium">
  {{ mn_disc }}
  <div class="flex flex--col flex--left portrait:flex--center-x gap--xsmall grow portrait:grow-0">
    <span class="title lg:title--large">{{ mn_phase }}</span>
    <span class="description lg:description--large">{{ mn_detail_short }}</span>
    <div class="flex flex--row gap--medium">
      <div class="flex flex--col flex--left gap--none"><span class="label label--small">{{ mn_w_rise_short }}</span><span class="value value--xsmall lg:value--small lg:portrait:{{ mn_q_size }} value--tnums mn-time">{{ mn_rise }}</span></div>
      <div class="flex flex--col flex--left gap--none"><span class="label label--small">{{ mn_w_set_short }}</span><span class="value value--xsmall lg:value--small lg:portrait:{{ mn_q_size }} value--tnums mn-time">{{ mn_set }}</span></div>
    </div>
    <div class="hidden lg:portrait:visible w--full">{{ mn_bar }}</div>
  </div>
</div>
{% else %}
{{ mn_empty }}
{% endif %}
{{ mn_title_bar }}
